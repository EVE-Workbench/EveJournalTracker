<UserControl x:Class="EWB_Tracker.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:EWB_Tracker.Views.Components"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             xmlns:converters="clr-namespace:SharedLibrary.Converters;assembly=SharedLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
            <Style x:Key="DraggableListBoxItem" TargetType="ListBoxItem">
                <Setter Property="AllowDrop" Value="True" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown" />
                <EventSetter Event="Drop" Handler="ListBoxItem_Drop" />
                <EventSetter Event="DragOver" Handler="ListBoxItem_DragOver" />
            </Style>
            <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="12" 
                                    Width="48" 
                                    Height="24">
                                <Grid>
                                    <Ellipse x:Name="circle" 
                                             Width="18" 
                                             Height="18" 
                                             HorizontalAlignment="Left" 
                                             Margin="3,0,0,0" 
                                             Fill="White" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="Green" />
                                    <Setter TargetName="circle" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="circle" Property="Margin" Value="0,0,3,0" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="Gray" />
                                    <Setter TargetName="circle" Property="HorizontalAlignment" Value="Left" />
                                    <Setter TargetName="circle" Property="Margin" Value="3,0,0,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" Padding="15">
            <Grid>
                <TextBlock Text="Character Management" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextColor}" />
                <TextBlock Text="Drag &amp; drop characters to reorder, toggle to activate/deactivate" 
                          HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" />
            </Grid>
        </Border>

        <!-- Character List -->
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding Characters}" 
                 Margin="0,10,0,0" 
                 Background="{DynamicResource PanelBackground}"
                 AllowDrop="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource DraggableListBoxItem}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Character}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Character Avatar -->
                        <components:CharacterAvatarControl Grid.Column="0" Character="{Binding}" AvatarSize="48" />

                        <!-- Character Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextColor}" />
                            <TextBlock Foreground="{DynamicResource TextColor}">
                                <Run Text="Online: " />
                                <Run Text="{Binding Online, Converter={StaticResource BoolToYesNoConverter}}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Active Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0">
                            <TextBlock Text="Active: " VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" />
                            <ToggleButton IsChecked="{Binding Active}" 
                                          Style="{StaticResource CustomToggleButtonStyle}" 
                                          VerticalAlignment="Center" 
                                          Margin="5,0,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer with Save Button -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="10" Margin="0,10,0,0">
            <Button Content="Save Changes" 
                   Command="{Binding SaveChangesCommand}"
                   HorizontalAlignment="Right" 
                   Padding="15,8"
                   Background="{DynamicResource CtaColor}"
                   Foreground="{DynamicResource TextColor}" />
        </Border>
    </Grid>
</UserControl>