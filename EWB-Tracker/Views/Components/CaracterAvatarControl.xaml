<UserControl x:Class="EWB_Tracker.Views.Components.CharacterAvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             xmlns:converters="clr-namespace:EWB_Tracker.Converters"
             mc:Ignorable="d" 
             x:Name="Root">
    
    <UserControl.Resources>
        <converters:CharacterIdToImageSourceConverter x:Key="CharacterIdToImageSourceConverter" />
    </UserControl.Resources>
    
    <Grid Width="{Binding AvatarSize, ElementName=Root}" 
          Height="{Binding AvatarSize, ElementName=Root}" 
          Margin="{Binding AvatarMargin, ElementName=Root}">
        <Ellipse StrokeThickness="2" Fill="Transparent">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Character.Online, ElementName=Root}" Value="True">
                            <Setter Property="Stroke" Value="Green" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Character.Online, ElementName=Root}" Value="False">
                            <Setter Property="Stroke" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
        <Ellipse Fill="White" Margin="2" />
        <Image Source="{Binding Character.CharacterId, ElementName=Root, Converter={StaticResource CharacterIdToImageSourceConverter}}"
               Width="{Binding InnerSize, ElementName=Root}" 
               Height="{Binding InnerSize, ElementName=Root}" 
               ClipToBounds="True" 
               Margin="2">
            <Image.Clip>
                <EllipseGeometry Center="{Binding CenterPoint, ElementName=Root}" 
                                 RadiusX="{Binding CircleRadius, ElementName=Root}" 
                                 RadiusY="{Binding CircleRadius, ElementName=Root}" />
            </Image.Clip>
        </Image>
    </Grid>
</UserControl>