<UserControl x:Class="EWB_Tracker.Views.DefaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             xmlns:converters="clr-namespace:SharedLibrary.Converters;assembly=SharedLibrary"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="400"
             Background="Transparent"
             d:DataContext="{d:DesignInstance }">
    <UserControl.Resources>
        <converters:BountyConverter x:Key="BountyConverter" />
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BountyRunStatusTextConverter x:Key="BountyRunStatusTextConverter" />
        <converters:BountyRunStatusColorConverter x:Key="BountyRunStatusColorConverter" />
    </UserControl.Resources>
    <StackPanel Margin="10">
        <!-- Bounty Runs Section -->
        <StackPanel Orientation="Horizontal" Margin="5 0">
            <TextBlock Text="Bounty Runs" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="(Renew: ctrl+shift+N)" FontSize="12" Foreground="Gray" Margin="5,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        
        <!-- Empty state for bounty runs -->
        <ContentControl Visibility="{Binding BountyRuns.Count, Converter={StaticResource ZeroToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Text="🚫 Currently there are no bounty runs being tracked" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" />
                <TextBlock Text="You can track your bounty per mission/event from the menu on the right." FontSize="12" Foreground="DarkGray" HorizontalAlignment="Center" />
            </StackPanel>
        </ContentControl>
        
        <!-- Bounty runs list -->
        <ItemsControl ItemsSource="{Binding BountyRuns}" 
                      Visibility="{Binding BountyRuns.Count, Converter={StaticResource ZeroToCollapsedConverter}}"
                      Margin="0,0,0,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:BountyRun}">
                    <Border BorderBrush="#cccccc" BorderThickness="1" Padding="10" Margin="5"
                            Background="{DynamicResource PanelBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource TextColor}" />
                                <TextBlock Foreground="{DynamicResource TextColor}" FontSize="12">
                                    Started: <Run Text="{Binding StartTime, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" />
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource TextColor}" FontSize="12"
                                           Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                                    Ended: <Run Text="{Binding EndTime, StringFormat='{}{0:MMM dd, yyyy HH:mm}'}" />
                                </TextBlock>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="10,0">
                                <TextBlock Text="Total ISK:" FontSize="12" 
                                           Foreground="{DynamicResource TextColor}" 
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding TotalIsk, Converter={StaticResource BountyConverter}}" 
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource AccentColor}" 
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                            
                            <Border Grid.Column="2" 
                                    Background="{Binding IsCompleted, Converter={StaticResource BountyRunStatusColorConverter}}"
                                    CornerRadius="12" Padding="8,4" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding IsCompleted, Converter={StaticResource BountyRunStatusTextConverter}}" 
                                           FontSize="10" FontWeight="Bold" 
                                           Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- Systems Section -->
        <TextBlock Text="Systems" FontSize="20" Margin="5 0" FontWeight="Bold" />
        <ContentControl Visibility="{Binding EveSystemCollection.Count, Converter={StaticResource ZeroToVisibleConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <TextBlock Text="🚫 No active bounty in systems" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" />
                <TextBlock Text="When you receive bounty in known systems, you'll see it here." FontSize="12" Foreground="DarkGray" HorizontalAlignment="Center" />
            </StackPanel>
        </ContentControl>
        <ItemsControl ItemsSource="{Binding EveSystemCollection}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:EveSystem}">
                    <Border BorderBrush="#cccccc" BorderThickness="1" Padding="5" Margin="5">
                        <StackPanel>
                            <TextBlock>
                                <Run Text="{Binding EveSystemDto.Name}" />
                                <Run Text=" (" />
                                <Run Text="{Binding EveSystemDto.SecurityStatus, StringFormat={}{0:F1}}"
                                     Foreground="{Binding EveSystemDto.SecurityColor}" />
                                <Run Text=")" />
                            </TextBlock>
                            <TextBlock Text="Bounty:" />
                            <TextBlock Text="{Binding Bounty, Converter={StaticResource BountyConverter}, FallbackValue=0}"
                                       Foreground="{DynamicResource AccentColor}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
    </StackPanel>
</UserControl>