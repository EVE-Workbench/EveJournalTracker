<UserControl x:Class="EWB_Tracker.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SharedLibrary.Converters;assembly=SharedLibrary"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:BountyConverter x:Key="BountyConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10 0 0 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Event logs" FontSize="20" FontWeight="Bold" 
                           Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextColor}" />

                <Button Grid.Column="1" Content="📂" ToolTip="Import" Margin="5,0" VerticalAlignment="Center" Click="ImportLogEvents_Click" />
                <Button Grid.Column="2" Content="🧹" ToolTip="Clear log" Margin="5,0" VerticalAlignment="Center" Click="ClearLogEvents_Click" />
                <Button Grid.Column="3" Content="🔃" ToolTip="Sort" Margin="5,0 0 0" VerticalAlignment="Center" Click="SortLogEvents_Click" />
            </Grid>
        </StackPanel>

        <!-- ListBox with Event Logs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Background="{DynamicResource PanelBackground}"
                      Margin="10 10 0 10">
            <ListBox x:Name="LogListBox" 
                     Margin="10 10 0 10" 
                     Background="{DynamicResource PanelBackground}" 
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:LogEvent}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextColor}">
                                <Run Text="{Binding Timestamp}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Character.Name}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Type}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Value}" />
                                <Run Text="{Binding BountyValue, Converter={StaticResource BountyConverter}}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
