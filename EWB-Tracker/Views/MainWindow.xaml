<Window x:Class="EWB_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SharedLibrary.Converters;assembly=SharedLibrary"
        xmlns:views="clr-namespace:EWB_Tracker.Views"
        xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
        Title="EVE Journal - EWB" Height="600" Width="1024">
    <Window.Resources>
        <converters:BountyConverter x:Key="BountyConverter"/>
        <converters:CharacterIdToImageSourceConverter x:Key="CharacterIdToImageSourceConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ISK Display -->
        <Border Grid.Column="0" Grid.Row="0" Margin="10 10 0 10" Padding="10 20" Background="#2E2E2E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalIsk, Converter={StaticResource BountyConverter}}" HorizontalAlignment="Center" FontSize="30" Foreground="#00ff00"/>
                <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="#00ff00">
                    + 
                    <TextBlock Text="{Binding IskChange, Converter={StaticResource BountyConverter}}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentView}" />
        </ScrollViewer>

        <!-- Character List -->
        <ListBox Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                 ItemsSource="{Binding Characters}" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Character}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding CharacterId, Converter={StaticResource CharacterIdToImageSourceConverter}}" Width="50" Height="50" Margin="5" ClipToBounds="True">
                            <Image.Clip>
                                <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                            </Image.Clip>
                        </Image>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock>
                                Bounty: 
                                <TextBlock Text="{Binding Bounty, Converter={StaticResource BountyConverter}}" />
                            </TextBlock>
                            <TextBlock>
                                System: 
                                <TextBlock Text="{Binding EveSystem.Name, FallbackValue='Unknown System'}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Toolbar -->
        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical"
                    Background="LightGray" Width="140">
            <TextBlock Text="Menu" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button Content="Bounties" Margin="5" Command="{Binding ShowViewCommand}">
                <Button.CommandParameter>
                    <views:DefaultView />
                </Button.CommandParameter>
            </Button>
            <Button Content="Account" Margin="5" Command="{Binding ShowViewCommand}">
                <Button.CommandParameter>
                    <views:AccountView />
                </Button.CommandParameter>
            </Button>
            <Button Content="Settings" Margin="5" Command="{Binding ShowViewCommand}">
                <Button.CommandParameter>
                    <views:SettingsView />
                </Button.CommandParameter>
            </Button>
            <Button Content="Log viewer" Margin="5" Command="{Binding ShowViewCommand}">
                <Button.CommandParameter>
                    <views:LogView />
                </Button.CommandParameter>
            </Button>
            <!-- Delimiter -->
            <Border BorderBrush="Black" BorderThickness="0 1 0 0" Margin="5"/>
            <Button Content="Stop" Margin="5" />
            <Button Content="New Lap" Margin="5"/>
            <Border BorderBrush="Black" BorderThickness="0 1 0 0" Margin="5"/>
            <Button Content="Exit" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
