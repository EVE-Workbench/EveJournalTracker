<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Font -->
    <FontFamily x:Key="AppFont">avares://UI.avalonia/Assets/Fonts/Shentox-Regular2.ttf#Shentox,Inter,Arial</FontFamily>

    <!-- Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBackground" Color="#2E2E2E" />
    <SolidColorBrush x:Key="TextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarTextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TitleBarButtonTextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonBackground" Color="#8B0000" />
    <SolidColorBrush x:Key="CloseButtonTextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentColor" Color="#00FF00" />
    <SolidColorBrush x:Key="CtaColor" Color="#0078a0" />
    <SolidColorBrush x:Key="WindowBorder" Color="#3E3E3E" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#3E3E3E" />
    <SolidColorBrush x:Key="ButtonTextColor" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#4E4E4E" />
    <SolidColorBrush x:Key="ButtonClickBackground" Color="#606060" />

</ResourceDictionary>
