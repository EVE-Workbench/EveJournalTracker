<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default TextBlock Style -->
    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <!-- Default Button Style -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextColor}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonClickBackground}" />
    </Style>

    <!-- EveBtn Style -->
    <Style Selector="Button.EveBtn">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.EveBtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.EveBtn:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonClickBackground}" />
    </Style>

    <!-- Active navigation button (current page): recessed/darker with a teal accent bar -->
    <Style Selector="Button.EveBtn.active">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource CtaColor}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style Selector="Button.EveBtn.active:pointerover">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>

    <!-- Compact monochrome icon buttons (e.g. the log viewer toolbar) -->
    <Style Selector="Button.IconBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.IconBtn:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
    </Style>

    <Style Selector="Button.IconBtn:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonClickBackground}" />
    </Style>

    <Style Selector="Button.IconBtn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>

    <!-- Window titlebar buttons (minimize / maximize / close): flat, edge-to-edge hover -->
    <Style Selector="Button.TitleBarBtn">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="45" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.TitleBarBtn /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.TitleBarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF" />
    </Style>

    <Style Selector="Button.TitleBarBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#2FFFFFFF" />
    </Style>

    <Style Selector="Button.TitleBarBtn.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
    </Style>

    <Style Selector="Button.TitleBarBtn.close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#C50F1F" />
    </Style>

    <Style Selector="Button.TitleBarBtn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource TitleBarButtonTextColor}" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
    </Style>

    <!-- ToggleSwitch Style for Show Offline Characters -->
    <Style Selector="ToggleSwitch">
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <!-- TextBlock inside ToggleSwitch should also use custom font -->
    <Style Selector="ToggleSwitch TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <!-- ToggleButton Style -->
    <Style Selector="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <Style Selector="ToggleButton.SwitchToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

</Styles>
