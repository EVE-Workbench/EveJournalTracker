<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:UI.avalonia.Views.Components"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             xmlns:converters="clr-namespace:UI.avalonia.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Class="UI.avalonia.Views.AccountView">

    <UserControl.Resources>
        <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" Padding="15">
            <Grid>
                <TextBlock Text="Character Management" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextColor}" />
                <TextBlock Text="Toggle to activate/deactivate characters"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" />
            </Grid>
        </Border>

        <!-- Character List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Characters}"
                 Margin="0,10,0,0"
                 Background="{DynamicResource PanelBackground}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Character">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Character Avatar -->
                        <components:CharacterAvatarControl Grid.Column="0" Character="{Binding}" AvatarSize="48" />

                        <!-- Character Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextColor}" />
                            <TextBlock Foreground="{DynamicResource TextColor}">
                                <Run Text="Online: " />
                                <Run Text="{Binding Online, Mode=OneWay, Converter={StaticResource BoolToYesNoConverter}}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Active Toggle -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0">
                            <TextBlock Text="Active: " VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" />
                            <ToggleSwitch IsChecked="{Binding Active}"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0"
                                          OnContent=""
                                          OffContent="" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer with Save Button -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" Padding="10" Margin="0,10,0,0">
            <Button Content="Save Changes"
                   Command="{Binding SaveChangesCommand}"
                   HorizontalAlignment="Right"
                   Padding="15,8"
                   Background="{DynamicResource CtaColor}"
                   Foreground="{DynamicResource TextColor}" />
        </Border>
    </Grid>
</UserControl>
