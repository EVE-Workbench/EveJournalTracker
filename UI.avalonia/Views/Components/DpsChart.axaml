<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:UI.avalonia.Controls"
             xmlns:vm="using:UI.avalonia.ViewModels"
             x:Class="UI.avalonia.Views.Components.DpsChart"
             x:DataType="vm:DpsChartViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*" Margin="6">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,4">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="OUT" FontSize="11" VerticalAlignment="Center" Foreground="#FF1E90FF" />
                    <TextBlock Text="{Binding DpsDealt, StringFormat='{}{0:N0}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#FF1E90FF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="IN" FontSize="11" VerticalAlignment="Center" Foreground="#FFFF4500" />
                    <TextBlock Text="{Binding DpsReceived, StringFormat='{}{0:N0}'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#FFFF4500" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Content="POP OUT ⤢" FontSize="10" Padding="6,2"
                    Click="OnPopOut" ToolTip.Tip="Open DPS meter as an always-on-top overlay" />
        </Grid>

        <ctrl:DpsGraph Grid.Row="1"
                       Series="{Binding Series}"
                       Revision="{Binding GraphRevision}"
                       Capacity="{Binding GraphPointCapacity}" />
    </Grid>
</UserControl>
