<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:UI.avalonia.Converters"
             xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Class="UI.avalonia.Views.LogView">

    <UserControl.Resources>
        <converters:BountyConverter x:Key="BountyConverter" />
        <converters:LogEventTypeToBrushConverter x:Key="LogEventTypeToBrushConverter" />
        <converters:LogEventSummaryConverter x:Key="LogEventSummaryConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header met icon group -->
        <Grid Grid.Row="0" Margin="10,4,10,4" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Event logs" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextColor}" />

            <Border Grid.Column="1" Background="{DynamicResource WindowBackground}"
                    CornerRadius="4" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="IconBtn" ToolTip.Tip="Load the full session"
                            Command="{Binding ImportLogEventsCommand}">
                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
                    </Button>
                    <Button Classes="IconBtn" ToolTip.Tip="Clear the log"
                            Command="{Binding ClearLogEventsCommand}">
                        <PathIcon Data="M6 19c0 1.1 0.9 2 2 2h8c1.1 0 2-0.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                    </Button>
                    <Button Classes="IconBtn" ToolTip.Tip="Toggle sort order (newest/oldest first)"
                            Command="{Binding SortLogEventsCommand}">
                        <PathIcon Data="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ListBox met Event Logs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource PanelBackground}"
                      Margin="10 10 0 10">
            <ListBox ItemsSource="{Binding LogEvents}"
                     x:Name="LogListBox"
                     Margin="10 10 0 10"
                     Background="{DynamicResource PanelBackground}"
                     Foreground="{DynamicResource TextColor}"
                     BorderBrush="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:LogEvent">
                        <Grid ColumnDefinitions="Auto,52,Auto,*" Margin="0,1">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                       FontFamily="Consolas,monospace" FontSize="11"
                                       Foreground="#7A7A7A" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <Border Grid.Column="1"
                                    Background="{Binding Type, Converter={StaticResource LogEventTypeToBrushConverter}}"
                                    CornerRadius="2" Height="15" Margin="0,0,8,0"
                                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Character.Name}"
                                       FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Converter={StaticResource LogEventSummaryConverter}}"
                                       FontFamily="Consolas,monospace" FontSize="11"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</UserControl>
