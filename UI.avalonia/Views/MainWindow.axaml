<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UI.avalonia.ViewModels"
        xmlns:views="using:UI.avalonia.Views"
        xmlns:components="using:UI.avalonia.Views.Components"
        xmlns:models="clr-namespace:SharedLibrary.Models;assembly=SharedLibrary"
        xmlns:converters="using:UI.avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="700"
        x:Class="UI.avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/eveworkbench-logo.ico"
        Title="EVE Workbench Desktop Agent"
        Width="1240" Height="700"
        MinWidth="980" MinHeight="650"
        SystemDecorations="None"
        CanResize="True"
        Background="Transparent">

    <Window.Resources>
        <converters:BountyConverter x:Key="BountyConverter" />
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
        <converters:BountyRunButtonTextConverter x:Key="BountyRunButtonTextConverter" />
        <converters:BountyRunButtonColorConverter x:Key="BountyRunButtonColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />
    </Window.Resources>

    <Grid>
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1">
        <Grid RowDefinitions="45,*">

            <!-- Custom titlebar -->
            <Panel Grid.Row="0"
                   Background="Transparent"
                   PointerPressed="TitleBar_PointerPressed">
                <TextBlock Text="EVE Workbench Desktop Agent"
                           VerticalAlignment="Center"
                           Margin="10 0"
                           FontSize="16"
                           Foreground="{DynamicResource TitleBarTextColor}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <Button Classes="TitleBarBtn" Click="Minimize_Click" ToolTip.Tip="Minimize">
                        <PathIcon Data="M4 11h16v1.5H4z" />
                    </Button>

                    <Button Classes="TitleBarBtn" Click="Maximize_Click" ToolTip.Tip="Maximize">
                        <PathIcon Data="M4 4h16v16H4V4zm2 2v12h12V6H6z" />
                    </Button>

                    <Button Classes="TitleBarBtn close" Click="Close_Click" ToolTip.Tip="Close">
                        <PathIcon Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </Button>
                </StackPanel>
            </Panel>

            <!-- Main Content -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,*">

                <!-- ISK Display -->
                <Border Grid.Column="0" Grid.Row="0" Margin="10 0 0 10" Padding="10 20"
                        Background="{DynamicResource PanelBackground}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalIsk, Converter={StaticResource BountyConverter}, FallbackValue=0}"
                                   HorizontalAlignment="Center" FontSize="30"
                                   Foreground="{DynamicResource AccentColor}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="+ " FontSize="20" Foreground="{DynamicResource AccentColor}" />
                            <TextBlock Text="{Binding IskChange, Converter={StaticResource BountyConverter}, FallbackValue=0}"
                                       FontSize="20" Foreground="{DynamicResource AccentColor}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentView}" />
                </ScrollViewer>

                <!-- Character List -->
                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" RowDefinitions="*,250">

                    <Panel Grid.Row="0">
                        <!-- Empty placeholder box -->
                        <Border Background="{DynamicResource PanelBackground}"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                Width="265"
                                Margin="10 0 10 10"
                                IsVisible="{Binding FilteredCharacters.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="No characters online"
                                           FontSize="16"
                                           Foreground="Gray"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />

                                <TextBlock Text="What are you doing? Not playing EvE? Are you really an EvE player if there are no clones online?"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="DarkGray"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredCharacters}" Margin="10 0 10 10"
                                 IsVisible="{Binding FilteredCharacters.Count, Converter={StaticResource ZeroToCollapsedConverter}}"
                                 Background="{DynamicResource PanelBackground}"
                                 Foreground="{DynamicResource TextColor}"
                                 MinWidth="265">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Character">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <components:CharacterAvatarControl Grid.Column="0" Character="{Binding}" AvatarSize="54" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextColor}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Bounty: " Foreground="{DynamicResource TextColor}" />
                                                <TextBlock Text="{Binding Bounty, Converter={StaticResource BountyConverter}}"
                                                           Foreground="{DynamicResource TextColor}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="System: " Foreground="{DynamicResource TextColor}" />
                                                <TextBlock Text="{Binding EveSystem.Name, FallbackValue='Unknown System'}"
                                                           Foreground="{DynamicResource TextColor}" />
                                                <TextBlock Text=" (" Foreground="{DynamicResource TextColor}" />
                                                <TextBlock Text="{Binding EveSystem.SecurityStatus, StringFormat={}{0:F1}, FallbackValue='?'}"
                                                           Foreground="{Binding EveSystem.SecurityColorHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                                <TextBlock Text=")" Foreground="{DynamicResource TextColor}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" Classes="IconBtn"
                                                VerticalAlignment="Center"
                                                Click="CharacterDps_Click"
                                                ToolTip.Tip="Open a DPS meter for this character">
                                            <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Panel>

                    <Border Grid.Row="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="10 0 10 10">

                        <components:DpsChart HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                    </Border>
                </Grid>

                <!-- Toolbar -->
                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                        Background="{DynamicResource PanelBackground}"
                        Width="170"
                        Margin="0 0 10 10">
                    <StackPanel Orientation="Vertical">
                        <Image Source="avares://UI.avalonia/Assets/eveworkbench-logo.png"
                               Width="150" Height="150" Margin="10 10 10 20" />

                        <Button Classes="EveBtn" Content="Bounties" Command="{Binding ShowViewCommand}"
                                Classes.active="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DefaultView}">
                            <Button.CommandParameter>
                                <views:DefaultView />
                            </Button.CommandParameter>
                        </Button>

                        <Button Classes="EveBtn" Content="Account" Command="{Binding ShowViewCommand}"
                                Classes.active="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AccountView}">
                            <Button.CommandParameter>
                                <views:AccountView />
                            </Button.CommandParameter>
                        </Button>

                        <Button Classes="EveBtn" Content="Settings" Command="{Binding ShowViewCommand}"
                                Classes.active="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SettingsView}">
                            <Button.CommandParameter>
                                <views:SettingsView />
                            </Button.CommandParameter>
                        </Button>

                        <Button Classes="EveBtn" Content="Log viewer" Command="{Binding ShowViewCommand}"
                                Classes.active="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=LogView}">
                            <Button.CommandParameter>
                                <views:LogView />
                            </Button.CommandParameter>
                        </Button>

                        <!-- Delimiter -->
                        <Border BorderBrush="{DynamicResource WindowBackground}" BorderThickness="0 1 0 0" Margin="5" />

                        <Button Content="Stop Watching" Classes="EveBtn" Click="StopWatching_Click" />
                        <Button Content="{Binding IsBountyRunActive, Converter={StaticResource BountyRunButtonTextConverter}}"
                                Classes="EveBtn"
                                Background="{Binding IsBountyRunActive, Converter={StaticResource BountyRunButtonColorConverter}}"
                                Click="BountyRunButton_Click" />

                        <!-- Delimiter -->
                        <Border BorderBrush="{DynamicResource WindowBackground}" BorderThickness="0 1 0 0" Margin="5" />

                        <!-- open evejournal.com in the browser -->
                        <Button Content="Open EVE Journal" Classes="EveBtn" Click="OpenEveJournal_Click" />

                        <Border BorderBrush="{DynamicResource WindowBackground}" BorderThickness="0 1 0 0" Margin="5" />
                        <StackPanel Margin="10,8" Spacing="4">
                            <TextBlock Text="Offline characters"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextColor}" />
                            <ToggleSwitch IsChecked="{Binding ShowOfflineCharacters}"
                                          OnContent="Shown"
                                          OffContent="Hidden"
                                          Foreground="{DynamicResource TextColor}"
                                          ToolTip.Tip="Show characters that are currently offline in the list" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Modal Overlay -->
                <Panel x:Name="ModalOverlay"
                       IsVisible="False"
                       Background="#80000000"
                       Grid.ColumnSpan="3" Grid.RowSpan="2"
                       ZIndex="10"
                       PointerPressed="ModalOverlay_PointerPressed">
                    <Border Background="{DynamicResource PanelBackground}"
                            Padding="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="8">
                        <ContentControl x:Name="ModalContent" />
                    </Border>
                </Panel>
            </Grid>
        </Grid>
    </Border>

        <!-- Manual resize grips: borderless window with reliable cross-platform resizing -->
        <Border Tag="West" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,8"
                Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="East" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,8"
                Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="North" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,0"
                Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="South" Height="5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0"
                Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="NorthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopLeftCorner"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="NorthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" Cursor="TopRightCorner"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="SouthWest" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomLeftCorner"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
        <Border Tag="SouthEast" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent" Cursor="BottomRightCorner"
                PointerPressed="ResizePressed" PointerMoved="ResizeMoved" PointerReleased="ResizeReleased" />
    </Grid>
</Window>
