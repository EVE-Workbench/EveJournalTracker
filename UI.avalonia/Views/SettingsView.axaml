<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:UI.avalonia.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="500"
             x:Class="UI.avalonia.Views.SettingsView"
             Background="Transparent">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,5" />
            <TextBlock Text="Configure your EVE Workbench Desktop Agent settings"
                       FontSize="12"
                       Foreground="Gray" />
        </StackPanel>

        <!-- Settings Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Agent Settings Section -->
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource WindowBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                            <TextBlock Text="Agent Settings" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Log location:"
                                   FontSize="14"
                                   Margin="0,0,0,5"
                                   Foreground="{DynamicResource TextColor}" />

                        <TextBox Text="{Binding LogDir}"
                                 FontSize="14"
                                 Padding="7"
                                 Margin="0,0,0,5"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextColor}"
                                 BorderBrush="{DynamicResource WindowBorder}"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />

                        <Button Command="{Binding AutoDetectLogDirCommand}"
                                Padding="10,6"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Left"
                                ToolTip.Tip="Scan common locations (incl. Steam/Proton and Wine on Linux) for the EVE gamelog folder">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Width="14" Height="14" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                                <TextBlock Text="Auto-detect log location" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="When changing the log location, please restart the application to apply changes"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />

                        <CheckBox Content="Load the full gamelog session on start"
                                  IsChecked="{Binding LoadFullSessionOnStart}"
                                  FontSize="14"
                                  Margin="0,12,0,0"
                                  Foreground="{DynamicResource TextColor}"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />

                        <TextBlock Text="When enabled, bounties and systems already logged before the agent started are loaded too. When disabled, only new lines from this moment on are tracked. The live DPS meter always ignores old lines either way. Restart to apply."
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Shortcuts Section -->
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource WindowBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                            <PathIcon Data="M20 5H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                            <TextBlock Text="Shortcuts" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Click Record, then press a key combination or a mouse button (mouse 3/4/5). Press Esc to cancel."
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextColor}" />
                                            <TextBlock Text="{Binding GestureDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AccentColor}"
                                                       IsVisible="{Binding IsRecording, Converter={StaticResource InverseBooleanConverter}}" />
                                            <TextBlock Text="Press a key or mouse button…  (Esc to cancel)"
                                                       FontSize="12"
                                                       Foreground="Orange"
                                                       IsVisible="{Binding IsRecording}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Record"
                                                Tag="{Binding CommandId}"
                                                Click="OnRecordShortcut"
                                                Padding="12,6"
                                                Margin="0,0,8,0" />
                                        <Button Grid.Column="2"
                                                Content="Clear"
                                                Tag="{Binding CommandId}"
                                                Click="OnClearShortcut"
                                                Padding="12,6" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="In-app, shortcuts (keyboard and mouse) work while this window is focused. For system-wide use while EVE is in front: on Windows keyboard shortcuts work everywhere automatically; on Linux (KDE Plasma) they are registered with the desktop — assign a key under System Settings → Shortcuts (look for this app). System-wide mouse buttons are not supported."
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- API Configuration Section -->
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource WindowBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <PathIcon Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                            <TextBlock Text="API Configuration" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="EWB Personal Access Token: "
                                       FontSize="14"
                                       Foreground="{DynamicResource TextColor}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="(open Access Tokens request page in browser)"
                                       FontSize="14"
                                       Foreground="#5599FF"
                                       TextDecorations="Underline"
                                       Cursor="Hand"
                                       VerticalAlignment="Center"
                                       PointerPressed="OnAccessTokenLinkPressed" />
                        </StackPanel>

                        <TextBox Text="{Binding ApiKey}"
                                 FontSize="14"
                                 Padding="7"
                                 Margin="0,0,0,5"
                                 Background="{DynamicResource WindowBackground}"
                                 Foreground="{DynamicResource TextColor}"
                                 BorderBrush="{DynamicResource WindowBorder}"
                                 PasswordChar="*"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />

                        <TextBlock Text="Enter your Eve Workbench Personal Access Token to enable website integration."
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Bounty Configuration Section -->
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource WindowBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,15">
                            <PathIcon Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                            <TextBlock Text="Bounty Configuration" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="Force all bounty to one character"
                                  IsChecked="{Binding ForceBountyToOneUser}"
                                  FontSize="14"
                                  Margin="0,0,0,15"
                                  Foreground="{DynamicResource TextColor}"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />

                        <TextBlock Text="Select Character:"
                                   FontSize="14"
                                   Margin="0,0,0,5"
                                   Foreground="{DynamicResource TextColor}"
                                   IsVisible="{Binding ForceBountyToOneUser, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <ComboBox ItemsSource="{Binding Characters}"
                                  SelectedItem="{Binding SelectedCharacter}"
                                  FontSize="14"
                                  Padding="10"
                                  Height="35"
                                  Margin="0,0,0,5"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource WindowBackground}"
                                  Foreground="{DynamicResource TextColor}"
                                  BorderBrush="{DynamicResource WindowBorder}"
                                  IsVisible="{Binding ForceBountyToOneUser, Converter={StaticResource BoolToVisibilityConverter}}"
                                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                        <TextBlock Text=" - " Foreground="Gray" />
                                        <TextBlock Text="{Binding Corporation}" Foreground="Gray" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="When enabled, all bounty tracking will be attributed to the selected character regardless of which character actually earned it"
                                   FontSize="10"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ForceBountyToOneUser, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Loading Indicator -->
                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="Orange"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="15"
                        IsVisible="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⟳" FontSize="16" Foreground="Orange">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Styles>
                                <Style Selector="TextBlock">
                                    <Style.Animations>
                                        <Animation Duration="0:0:1" IterationCount="Infinite">
                                            <KeyFrame Cue="0%">
                                                <Setter Property="(RotateTransform.Angle)" Value="0" />
                                            </KeyFrame>
                                            <KeyFrame Cue="100%">
                                                <Setter Property="(RotateTransform.Angle)" Value="360" />
                                            </KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                        <TextBlock Text=" Loading..." FontSize="14" Foreground="Orange" Margin="5,0,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource WindowBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Command="{Binding LoadCommand}"
                        Margin="0,0,10,0"
                        Padding="15,8"
                        ToolTip.Tip="Reload settings from database">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Width="14" Height="14" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding SaveCommand}"
                        Background="{DynamicResource CtaColor}"
                        Padding="20,8"
                        ToolTip.Tip="Save all settings to database">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                                  Width="14" Height="14" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" />
                        <TextBlock Text="Save Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
